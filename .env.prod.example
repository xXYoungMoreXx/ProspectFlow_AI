# ============================================================
# .env.prod — Production environment variables
# Copy this file to .env.prod and fill in all values.
# NEVER commit .env.prod to git.
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=production
DOMAIN=agentepro.yourdomain.com
NEXT_PUBLIC_API_URL=https://agentepro.yourdomain.com/api/v1

# ── Database ─────────────────────────────────────────────────
POSTGRES_DB=agentepro
POSTGRES_USER=agentepro
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
DATABASE_URL=postgresql://agentepro:CHANGE_ME@postgres:5432/agentepro

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379

# ── Auth (RS256 JWT) ─────────────────────────────────────────
# Generate: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_BASE64=BASE64_OF_PEM_PRIVATE_KEY
JWT_PUBLIC_KEY_BASE64=BASE64_OF_PEM_PUBLIC_KEY
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Settings encryption ───────────────────────────────────────
# Generate: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=CHANGE_ME_32_bytes_base64_key

# ── LLM Providers ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_AI_API_KEY=...

# ── Messaging ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...
EVOLUTION_API_URL=https://your-evolution-api.com
EVOLUTION_API_KEY=...

# ── Agent Runtime ────────────────────────────────────────────
AGENTEPRO_API_URL=http://api:3001
AGENTEPRO_API_TOKEN=CHANGE_ME_internal_api_token
RUNTIME_HOST=0.0.0.0
RUNTIME_PORT=8080

# ── Optional integrations ─────────────────────────────────────
GOOGLE_MAPS_API_KEY=
CALCOM_API_KEY=
HEYGEN_API_KEY=
BREVO_API_KEY=

# ── Observability (optional) ──────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
