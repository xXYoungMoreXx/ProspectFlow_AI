{
  "name": "@agentepro/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:unit": "vitest run src/domain",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:security": "vitest run tests/security/ --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:silent": "tsx src/infrastructure/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@agentepro/shared-types": "*",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^5.2.6",
    "@noble/hashes": "^2.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.3",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "fastify-metrics": "^13.2.1",
    "fastify-opentelemetry": "^1.0.3",
    "file-type": "^21.3.2",
    "ioredis": "^5.10.1",
    "jose": "^6.2.8",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.9",
    "ulid": "^2.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "supertest": "^7.1.0",
    "testcontainers": "^12.0.0",
    "tsx": "^4.23.10",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
