FROM node:22-alpine AS base
ENV npm_config_loglevel=warn

# 1. Install dependencies
FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared-types/package.json ./packages/shared-types/
RUN npm ci --workspace=@hefesto/web --workspace=@hefesto/shared-types --include-workspace-root

# 2. Build shared-types + Next.js app
FROM deps AS builder
WORKDIR /app
COPY tsconfig.base.json ./
COPY packages/shared-types ./packages/shared-types
COPY apps/web ./apps/web
COPY turbo.json ./

ENV NEXT_TELEMETRY_DISABLED=1
RUN npx turbo run build --filter=@hefesto/web...

# 3. Production runner
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder /app/apps/web/public ./public

# Leverage Next.js standalone output (see next.config.js: output: 'standalone')
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static

USER nextjs

ENV PORT=3000
EXPOSE 3000

CMD ["node", "apps/web/server.js"]
