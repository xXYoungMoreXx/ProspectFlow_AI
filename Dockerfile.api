# Base node image
FROM node:20-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

# 1. Prune the workspace for the API app
FROM base AS builder
WORKDIR /app
RUN npm install -g turbo
COPY . .
RUN turbo prune --scope=@agentepro/api --docker

# 2. Install dependencies
FROM base AS installer
WORKDIR /app

# Install dependencies (only what's needed for api and its shared libs)
COPY --from=builder /app/out/json/ .
COPY --from=builder /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

# Build the project and its dependencies
COPY --from=builder /app/out/full/ .
RUN pnpm turbo run build --filter=@agentepro/api...

# 3. Production runner
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production

# Don't run production as root
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 fastify

# Copy production dependencies (or re-install production only)
COPY --from=installer --chown=fastify:nodejs /app/node_modules ./node_modules
COPY --from=installer --chown=fastify:nodejs /app/apps/api/node_modules ./apps/api/node_modules

# Copy built application
COPY --from=installer --chown=fastify:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=installer --chown=fastify:nodejs /app/apps/api/package.json ./apps/api/package.json

USER fastify

# Cloud Run enforces the PORT environment variable
ENV PORT=3001
EXPOSE 3001

CMD ["node", "apps/api/dist/server.js"]
