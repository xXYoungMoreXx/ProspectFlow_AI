{
  "title": "Hefesto — Quality (Lighthouse + QA)",
  "uid": "hefesto-quality",
  "tags": ["hefesto", "quality", "lighthouse"],
  "panels": [
    {
      "title": "Lead Qualification Score (P50/P90/P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(hefesto_lead_qualification_score_bucket[5m]))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.90, rate(hefesto_lead_qualification_score_bucket[5m]))",
          "legendFormat": "P90"
        },
        {
          "expr": "histogram_quantile(0.99, rate(hefesto_lead_qualification_score_bucket[5m]))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "title": "Agent Task Success Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(hefesto_agent_tasks_total{status='completed'}[1h])) / sum(rate(hefesto_agent_tasks_total[1h]))",
          "legendFormat": "Success Rate"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
