{
  "title": "AgentePro — Agents & LLM",
  "uid": "agentepro-agents",
  "tags": ["agentepro", "agents", "llm"],
  "panels": [
    {
      "title": "Tokens Consumed (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(agentepro_agent_tokens_consumed_total)",
          "legendFormat": "Tokens"
        }
      ]
    },
    {
      "title": "LLM Requests by Provider",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (provider) (agentepro_llm_requests_total)",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "title": "Token Consumption Rate by Provider",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "rate(agentepro_agent_tokens_consumed_total[5m])",
          "legendFormat": "{{persona}} / {{provider}}"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
