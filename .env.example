# ═══════════════════════════════════════════════════════════════════════════════
# Hefesto — Environment Variables Example
# Copy to .env.local (gitignored) and fill with real values
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Local-first mode (self-hosted, single machine) ───────────────────────────
# `local` (default) enables the offline first-run admin: the web shows a setup
# screen, you create an admin (no SMTP/email verification needed) and sign in.
# Set to `cloud` for a managed deployment (disables /auth/local-login).
APP_MODE=local
# Frontend mirror of APP_MODE. When `local`, the web shows the BackendGuard:
# guides the user to start the backend, and the first-run setup screen.
NEXT_PUBLIC_APP_MODE=local
# Pre-filled e-mail on the first-run setup screen (you choose the password).
NEXT_PUBLIC_LOCAL_ADMIN_EMAIL=admin@hefesto.local
# Optional: default credentials used by /auth/local-login when none are sent
# (and by the opt-in NEXT_PUBLIC_DEV_AUTO_LOGIN auto-login). Local mode only.
DEV_ADMIN_EMAIL=admin@hefesto.local
DEV_ADMIN_PASSWORD=change-me-please

# ── Database (PostgreSQL 16) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://hefesto:hefesto_dev@localhost:5432/hefesto

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (RS256 — generate with: openssl genpkey -algorithm RSA -out jwt.key -pkeyopt rsa_keygen_bits:2048)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=hefesto.local
JWT_AUDIENCE=hefesto-api
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# ── HITL ─────────────────────────────────────────────────────────────────────
HITL_DEFAULT_TIMEOUT_MINUTES=60

# ── ChromaDB (RAG) ──────────────────────────────────────────────────────────
CHROMADB_URL=http://localhost:8000

# ── Agent Runtime ────────────────────────────────────────────────────────────
AGENT_RUNTIME_URL=http://localhost:8001

# ── LLM Providers (set in vault/env, never commit real keys) ─────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIza-xxxxxxxxxxxxxxxxxxxx

# ── External Services ───────────────────────────────────────────────────────
# WhatsApp (Evolution API)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=xxxxxxxxxxxxxxxxxxxx
WPP_INSTANCE=hefesto

# Email (Brevo)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_NAME=Hefesto
EMAIL_FROM_ADDRESS=noreply@hefesto.com

# ── Vercel (Site Deploy) ────────────────────────────────────────────────────
VERCEL_TOKEN=xxxxxxxxxxxxxxxxxxxx

# ── Webhooks ────────────────────────────────────────────────────────────────
WEBHOOK_URL=
WEBHOOK_SECRET=

# ── Limits ──────────────────────────────────────────────────────────────────
MAX_BODY_SIZE=1048576

# ── Brasil MCP ──────────────────────────────────────────────────────────────
TRANSPARENCIA_API_KEY=
DATAJUD_API_KEY=
META_ACCESS_TOKEN=
MCP_BRASIL_DATASETS=tse_candidatos,tse_bens,tse_votacao

# ── Bootstrap (multi-tenant seed) ──────────────────────────────────────────
BOOTSTRAP_ORG_ID=org_mvp
BOOTSTRAP_ORG_NAME=Hefesto
BOOTSTRAP_ORG_SLUG=hefesto

# ── Settings Hub (Phase 20) ─────────────────────────────────────────────────
# AES-256-GCM key for encrypting secrets in DB. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=

# Ollama Local LLM Runtime
OLLAMA_BASE_URL=http://localhost:11434

# ── Cal.com (meeting scheduling) ────────────────────────────────────────────
# API key from app.cal.com/settings/developer/api-keys
CALCOM_API_KEY=
CALCOM_DEFAULT_EVENT_SLUG=demo-30min

# --- Deploy providers + internal bridge (adicionado 2026-06-12) ---
GOOGLE_MAPS_API_KEY=        # Google Places (Hunter places_search)
CF_ACCOUNT_ID=              # Cloudflare Pages (fallback deploy)
CF_API_TOKEN=
NETLIFY_TOKEN=              # Netlify (fallback deploy real)
RENDER_API_KEY=             # Render (fallback deploy via hook)
PAGESPEED_API_KEY=          # QA Lighthouse via PageSpeed Insights
INTERNAL_API_TOKEN=         # Shared secret rotas /api/v1/internal/* — igual ao API_TOKEN do agent-runtime
