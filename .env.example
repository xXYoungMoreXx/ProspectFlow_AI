# ═══════════════════════════════════════════════════════════════════════════════
# AgentePro — Environment Variables Example
# Copy to .env.local (gitignored) and fill with real values
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Database (PostgreSQL 16) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://agentepro:agentepro_dev@localhost:5432/agentepro

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (RS256 — generate with: openssl genpkey -algorithm RSA -out jwt.key -pkeyopt rsa_keygen_bits:2048)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=agentepro.local
JWT_AUDIENCE=agentepro-api
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# ── HITL ─────────────────────────────────────────────────────────────────────
HITL_DEFAULT_TIMEOUT_MINUTES=60

# ── ChromaDB (RAG) ──────────────────────────────────────────────────────────
CHROMADB_URL=http://localhost:8000

# ── Agent Runtime ────────────────────────────────────────────────────────────
AGENT_RUNTIME_URL=http://localhost:8001

# ── LLM Providers (set in vault/env, never commit real keys) ─────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIza-xxxxxxxxxxxxxxxxxxxx

# ── External Services ───────────────────────────────────────────────────────
# WhatsApp (Evolution API)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=xxxxxxxxxxxxxxxxxxxx
WPP_INSTANCE=agentepro

# Email (Brevo)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_NAME=AgentePro
EMAIL_FROM_ADDRESS=noreply@agentepro.com

# ── Vercel (Site Deploy) ────────────────────────────────────────────────────
VERCEL_TOKEN=xxxxxxxxxxxxxxxxxxxx

# ── Webhooks ────────────────────────────────────────────────────────────────
WEBHOOK_URL=
WEBHOOK_SECRET=

# ── Limits ──────────────────────────────────────────────────────────────────
MAX_BODY_SIZE=1048576

# ── Brasil MCP ──────────────────────────────────────────────────────────────
TRANSPARENCIA_API_KEY=
DATAJUD_API_KEY=
META_ACCESS_TOKEN=
MCP_BRASIL_DATASETS=tse_candidatos,tse_bens,tse_votacao

# ── Bootstrap (multi-tenant seed) ──────────────────────────────────────────
BOOTSTRAP_ORG_ID=org_mvp
BOOTSTRAP_ORG_NAME=AgentePro
BOOTSTRAP_ORG_SLUG=agentepro

# ── Settings Hub (Phase 20) ─────────────────────────────────────────────────
# AES-256-GCM key for encrypting secrets in DB. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=

# Ollama Local LLM Runtime
OLLAMA_BASE_URL=http://localhost:11434

# ── Cal.com (meeting scheduling) ────────────────────────────────────────────
# API key from app.cal.com/settings/developer/api-keys
CALCOM_API_KEY=
CALCOM_DEFAULT_EVENT_SLUG=demo-30min
