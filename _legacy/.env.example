# ══════════════════════════════════════════════════════════════════
#  ProspectFlow AI — Variáveis de Ambiente
#  Copie para .env e preencha todos os valores
# ══════════════════════════════════════════════════════════════════

# ── Banco de dados ─────────────────────────────────────────────────
POSTGRES_USER=pf_user
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE

# ── Redis ──────────────────────────────────────────────────────────
REDIS_PASSWORD=TROQUE_POR_SENHA_FORTE

# ── Aplicação ──────────────────────────────────────────────────────
SECRET_KEY=GERE_COM_openssl_rand_hex_32
ENVIRONMENT=production  # development | production

# ── LLM ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Alternativa OpenAI:
# OPENAI_API_KEY=sk-...

# ── Google Maps ────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIza...
# Budget mensal em USD (proteção de custo)
GOOGLE_MAPS_MONTHLY_BUDGET_USD=30

# ── WhatsApp (Evolution API) ───────────────────────────────────────
EVOLUTION_API_KEY=GERE_UM_TOKEN_ALEATORIO

# ── E-mail (Brevo/Sendinblue) ─────────────────────────────────────
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_NAME=ProspectFlow Sites
BREVO_SENDER_EMAIL=contato@seudominio.com.br

# ── Publicação de sites ────────────────────────────────────────────
VERCEL_TOKEN=...
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_ACCOUNT_ID=...

# ── Integrações CRM (opcionais) ────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=
RDSTATION_CLIENT_ID=
RDSTATION_CLIENT_SECRET=
PIPEDRIVE_API_TOKEN=

# ── Webhook genérico (opcional) ────────────────────────────────────
WEBHOOK_URL=
WEBHOOK_SECRET=

# ── Monitoramento ──────────────────────────────────────────────────
GRAFANA_PASSWORD=TROQUE_POR_SENHA_FORTE

# ── Configurações de negócio ───────────────────────────────────────
# Máx de novos leads contactados por dia (warm-up progressivo)
DAILY_NEW_LEADS_LIMIT=50
# Ticket médio padrão (R$) - pode ser sobrescrito por nicho
DEFAULT_SITE_PRICE=1200
# Dias de garantia oferecidos
WARRANTY_DAYS=30
# Nome da sua empresa/marca
BRAND_NAME=WebPro Sites
