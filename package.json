{
  "name": "hefesto",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "init": "node scripts/init.js start",
    "stop": "node scripts/init.js stop",
    "restart": "node scripts/init.js restart",
    "check": "node scripts/init.js check",
    "status": "node scripts/init.js status",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.5.0",
    "turbo": "^2.9.16",
    "typescript": "^5.8.0"
  },
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": ">=8.5.10",
    "protobufjs": "8.6.4",
    "@grpc/proto-loader": {
      "protobufjs": "8.6.4"
    },
    "@grpc/grpc-js": "1.14.4",
    "hono": "4.12.26",
    "form-data": "4.0.6",
    "js-yaml": "4.2.0",
    "vite": "7.3.5",
    "@babel/core": "7.29.7",
    "esbuild": "0.28.1",
    "@opentelemetry/core": "2.8.0"
  }
}
