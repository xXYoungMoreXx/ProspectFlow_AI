{
  "name": "agentepro",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "init": "node scripts/init.js start",
    "stop": "node scripts/init.js stop",
    "restart": "node scripts/init.js restart",
    "check": "node scripts/init.js check",
    "status": "node scripts/init.js status",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "^5.8.0"
  },
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": ">=8.5.10",
    "protobufjs": ">=8.0.2",
    "@grpc/proto-loader": {
      "protobufjs": ">=8.0.2"
    }
  }
}
